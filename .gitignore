steam_api64.dll
steam.zip

# Generated by tauri-plugin's build.rs from the COMMANDS list. Unlike the sibling
# commands/*.toml files it carries no "DO NOT EDIT" header, so it reads like a hand-written doc
# and invites edits that the next build silently overwrites. Its content just restates
# permissions/default.toml, so there is nothing to review in a diff. The commands/*.toml files
# ARE tracked — those are the permission contract and a new one must be visible in review.
packages/tauri-plugin-caiji-admob/permissions/autogenerated/reference.md

# Local secrets / real service IDs, kept out of git. The AdMob ids are not strictly secret (the
# App ID ships in AndroidManifest.xml and the ad-unit ids in the JS bundle, so anyone can pull
# them out of an APK), but publishing them invites scrapers to use your ad units in their own
# apps — that traffic counts as invalid and gets *your* account flagged.
*.local.sh
.env.local
.env.*.local
